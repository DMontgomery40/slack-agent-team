<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Example LaunchAgent for one relay instance. launchd does not expand ~ or $HOME:
  replace every REPLACE_WITH_* token with an absolute path, and INSTANCE with your instance name.
  Save as ~/Library/LaunchAgents/com.example.slack-agent-team.relay.INSTANCE.plist (mode 600).
-->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>REPLACE_WITH_HOME_DIR</string>
		<key>PATH</key>
		<string>REPLACE_WITH_DIRS_OF_YOUR_AGENT_CLIS:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.example.slack-agent-team.relay.INSTANCE</string>
	<key>ProgramArguments</key>
	<array>
		<string>REPLACE_WITH_RELAY_DIR/.venv/bin/python</string>
		<string>REPLACE_WITH_RELAY_DIR/service.py</string>
		<string>--instance</string>
		<string>REPLACE_WITH_RELAY_DIR/instances/INSTANCE</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>REPLACE_WITH_RELAY_DIR/instances/INSTANCE/relay-error.log</string>
	<key>StandardOutPath</key>
	<string>REPLACE_WITH_RELAY_DIR/instances/INSTANCE/relay.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>Umask</key>
	<integer>63</integer>
	<key>WorkingDirectory</key>
	<string>REPLACE_WITH_RELAY_DIR/instances/INSTANCE</string>
</dict>
</plist>
